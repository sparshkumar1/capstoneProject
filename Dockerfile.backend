FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# The backend process imports the evaluator (SBERT/FAISS/CrossEncoder), the RL/PPO
# difficulty controller, and the audio/WhisperX stack in-process (apps/backend/main.py),
# each guarded by try/except -- so without these, the container starts but silently
# falls back to mock scores / heuristic difficulty / no transcription. All four are
# required for the real, evaluated behaviour this app reports.
COPY requirements/base.txt requirements/backend.txt requirements/evaluator.txt requirements/rl.txt requirements/audio.txt /tmp/requirements/

RUN python -m pip install --upgrade pip && \
    pip install \
      -r /tmp/requirements/base.txt \
      -r /tmp/requirements/backend.txt \
      -r /tmp/requirements/evaluator.txt \
      -r /tmp/requirements/rl.txt \
      -r /tmp/requirements/audio.txt

COPY . /app

EXPOSE 8000

CMD ["uvicorn", "apps.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
