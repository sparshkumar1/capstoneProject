# PrepAIred environment variables
# Copy to .env and fill in your values. Never commit the real .env.

# ── Actually read by code ─────────────────────────────────────────────────

# Backend -> Qwen microservice URL (agents/orchestrator/feedback_agent.py,
# agents/orchestrator/interview_orchestrator.py). In docker-compose this is
# http://qwen:8001 (container-network name), not localhost.
QWEN_URL=http://localhost:8001

# Required to elevate a login to admin (apps/backend/main.py /api/login).
# Leave unset and admin login is always rejected -- there is no default password.
ADMIN_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS. Leave blank to
# keep the localhost-only dev defaults baked into apps/backend/main.py.
CORS_ORIGINS=

# Where the SQLite file lives (services/storage/database.py). Point this at a
# mounted persistent volume in any deployment that isn't a single long-lived host.
PREPAIRED_DB_PATH=

# The public hostname Caddy requests a TLS cert for (deploy/Caddyfile) and the
# frontend is built against (see docker-compose.yml frontend.build.args).
PUBLIC_DOMAIN=

# Qwen GGUF model path override (services/qwen/app.py). Default is
# <repo-root>/models/gguf/qwen2.5-1.5b-instruct-q4_k_m.gguf -- run
# `python scripts/download_qwen_model.py` to fetch it.
PREPAIRED_GGUF_PATH=

# "1"/"true" lets services/qwen/app.py fall back to downloading
# Qwen/Qwen2.5-1.5B-Instruct from Hugging Face via transformers if the GGUF
# file above is missing. Off by default (CPU-only, no GPU assumed).
ENABLE_GPU_RESEARCH_MODELS=0

# Optional: swap services/qwen/app.py from the local GGUF model to a hosted
# OpenAI-compatible chat completions endpoint (e.g. Groq serving a Qwen
# model), for deployments without a local model file. Leave LLM_BASE_URL
# blank to keep the default local GGUF inference -- setting it alone enables
# hosted mode. Never commit a real LLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# C-sandbox Docker image name (agents/coding_executor/coding_executor.py).
# Note the actual env var name is SANDBOX_DOCKER_IMAGE, not DOCKER_SANDBOX_IMAGE.
SANDBOX_DOCKER_IMAGE=prepaired-c-sandbox:latest

# ── Declared here for documentation but NOT read by any current code path ──
# (kept as placeholders so a future wiring pass has an obvious home for them;
#  do not rely on setting these to change behavior today)

EVALUATOR_URL=http://localhost:5000
BACKEND_URL=http://localhost:8000
EVALUATOR_MODEL_DIR=services/evaluator/models
EVALUATOR_ASSETS_DIR=services/evaluator/assets
RL_MODEL_PATH=rl/checkpoints/seed_123/ppo_final.zip
RL_VEC_PATH=rl/checkpoints/seed_123/vecnormalize.pkl
SECRET_KEY=
WHISPERX_DEVICE=cpu
WHISPERX_MODEL_SIZE=base
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_LANGUAGE=en

# Weights & Biases (experiment tracking; NEVER put the API key here -- use `wandb login`)
# Not used by any current code path. Intended for future PPO runs only.
WANDB_PROJECT=prepaired
WANDB_ENTITY=
WANDB_MODE=online
