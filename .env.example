# PrepAIred environment variables
# Copy to .env and fill in your values

# Service URLs (defaults for local dev)
EVALUATOR_URL=http://localhost:5000
QWEN_URL=http://localhost:8001
BACKEND_URL=http://localhost:8000

# Evaluator
EVALUATOR_MODEL_DIR=services/evaluator/models
EVALUATOR_ASSETS_DIR=services/evaluator/assets

# RL Policy
RL_MODEL_PATH=rl/checkpoints/seed_123/ppo_final.zip
RL_VEC_PATH=rl/checkpoints/seed_123/vecnormalize.pkl

# Qwen LLM (optional — leave blank to disable)
QWEN_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Auth (dev defaults — change in production)
SECRET_KEY=dev-secret-key-change-in-production
